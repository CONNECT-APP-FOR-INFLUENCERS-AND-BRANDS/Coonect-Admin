# =============================================================================
# Connect Admin — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend GraphQL endpoint (same API the mobile apps use)
# -----------------------------------------------------------------------------
VITE_BACKEND_GRAPHQL_URL=http://localhost:5001/graphql

# -----------------------------------------------------------------------------
# Firebase Web App config — Firebase Console -> Project Settings -> General ->
# "Your apps" -> Web app (add one if none exists; it's free, same project the
# backend's FIREBASE_SERVICE_ACCOUNT and the mobile apps already use).
# These are public client identifiers, not secrets.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
